# Copy this file to .env and paste your SmartSpectra API key.
# Get a key at https://physiology.presagetech.com/
SMARTSPECTRA_API_KEY=

# SmartSpectra SDK telemetry (aggregate session summary, no video or readings).
# Kitchen Chaos turns it off by default. Set to true to share it with Presage.
SMARTSPECTRA_TELEMETRY=false
